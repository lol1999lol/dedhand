{
  "name": "dedhand",
  "version": "2.0.0",
  "private": false,
  "license": "MIT",
  "description": "Headless dead-hand daemon. No web UI, no inbound ports. Check in or publish to channels you own.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dedhand": "./bin/dedhand.js"
  },
  "files": [
    "bin",
    "server",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/dedhand.js daemon",
    "setup": "node bin/dedhand.js setup",
    "status": "node bin/dedhand.js status",
    "doctor": "node bin/dedhand.js doctor",
    "test": "node scripts/check.mjs"
  },
  "keywords": [
    "dead-hand",
    "dead-man-switch",
    "daemon",
    "telegram",
    "security"
  ],
  "dependencies": {
    "archiver": "^7.0.1"
  }
}
